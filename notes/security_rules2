### Proposed V4

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- READ-ONLY COLLECTIONS (for authenticated users) ---
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins should write
    }
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins should write
    }
    match /sponsors/{sponsorId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins should write
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if request.auth.uid == userId;
    }

    // --- CHAT RULES (NEW FOR PHASE 2) ---
    match /sessions/{sessionId}/chat/{messageId} {
      allow read: if isAuthenticated();
      // Users can only create messages where they are the sender.
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      // In Phase 3, we'll add rules for speakers to delete messages.
    }

    // --- CHECK-IN RULES (NEW FOR PHASE 2) ---
    match /sessions/{sessionId}/checkins/{userId} {
      allow read: if isAuthenticated();
      // A user can only create a check-in for themselves.
      allow create: if isAuthenticated() && userId == request.auth.uid;
    }
  }
}



