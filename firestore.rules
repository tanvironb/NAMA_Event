rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn()
          && (request.auth.uid == userId || isAdmin());
      }
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /registrations/{userId} {
        allow read: if isSignedIn();

        allow create, update: if isSignedIn()
          && (request.auth.uid == userId || isAdmin());

        allow delete: if isAdmin();
      }

      // New role-based certificate templates:
      // attendee, speaker, moderator and staff.
      match /certificateTemplates/{role} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }

      // Backward compatibility with the old template path:
      // events/{eventId}/certificateTemplate/main
      match /certificateTemplate/{templateId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }

      // Only admins may create, edit or delete certificates.
      // A user may read only their own certificate.
      match /certificates/{certificateId} {
        allow read: if isAdmin()
          || (
            isSignedIn()
            && resource.data.userId == request.auth.uid
          );

        allow create, update, delete: if isAdmin();
      }

      // Controls whether certificates have been generated/published.
      match /certificateSettings/{settingsId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }

      // Existing event subcollection behavior remains unchanged,
      // except for the protected certificate collections above.
      match /{subCollection}/{docId} {
        allow read: if isSignedIn();

        allow write: if isSignedIn()
          && subCollection != "certificateTemplates"
          && subCollection != "certificateTemplate"
          && subCollection != "certificates"
          && subCollection != "certificateSettings";
      }
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /{subCollection}/{docId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}