rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function isStaff() {
      return isSignedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'staff';
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }

    function isImageUnder10MB() {
      return request.resource == null ||
        (
          request.resource.size < 10 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*')
        );
    }

    // ------------------------------------------------------------
    // EMAIL ASSETS
    // ------------------------------------------------------------
    match /email/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder10MB();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // EVENT FILES
    // ------------------------------------------------------------
    match /events/{eventId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isImageUnder10MB();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // SESSION FILES
    // ------------------------------------------------------------
    match /sessions/{sessionId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrStaff() && isImageUnder10MB();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // USER PROFILE IMAGES
    // users/{userId}/...
    // ------------------------------------------------------------
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update: if
        (request.auth.uid == userId || isAdmin()) &&
        isImageUnder10MB();

      allow delete: if
        request.auth.uid == userId || isAdmin();
    }

    // ------------------------------------------------------------
    // ALTERNATIVE PROFILE IMAGE PATH
    // profile_images/{userId}/...
    // ------------------------------------------------------------
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update: if
        (request.auth.uid == userId || isAdmin()) &&
        isImageUnder10MB();

      allow delete: if
        request.auth.uid == userId || isAdmin();
    }

    // ------------------------------------------------------------
    // CURRENT PROFILE IMAGE PATH USED BY STORAGE SERVICE
    // profile/{userId}.jpg
    // ------------------------------------------------------------
    match /profile/{fileName} {
      allow read: if isSignedIn();

      allow create, update: if
        (
          fileName == request.auth.uid + '.jpg' ||
          isAdmin()
        ) &&
        isImageUnder10MB();

      allow delete: if
        fileName == request.auth.uid + '.jpg' ||
        isAdmin();
    }

    // ------------------------------------------------------------
    // CERTIFICATE FILES
    // ------------------------------------------------------------
    match /certificates/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // EVERYTHING ELSE
    // ------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}