rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function isStaff() {
      return isSignedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'staff';
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }

    function isImageUnder10MB() {
      return request.resource == null ||
        (
          request.resource.size < 10 * 1024 * 1024 &&
          request.resource.contentType != null &&
          request.resource.contentType.matches('image/.*')
        );
    }

    // ------------------------------------------------------------
    // EMAIL ASSETS
    // ------------------------------------------------------------
    match /email/{fileName} {
      allow read: if true;

      allow create, update:
        if isAdmin() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // SESSION / EVENT PHOTO UPLOAD PATHS
    //
    // Signed-in attendees, speakers, moderators, staff and admins
    // may upload image files to these photo-only folders.
    // Only admin may delete files.
    // ------------------------------------------------------------

    match /events/{eventId}/eventPhotos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /events/{eventId}/event_photos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /events/{eventId}/sessionPhotos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /events/{eventId}/session_photos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /eventPhotos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /event_photos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /sessionPhotos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /session_photos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /sessions/{sessionId}/photos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    match /sessions/{sessionId}/eventPhotos/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // OTHER EVENT FILES
    // ------------------------------------------------------------
    match /events/{eventId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isAdmin() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // OTHER SESSION FILES
    // ------------------------------------------------------------
    match /sessions/{sessionId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isAdminOrStaff() && isImageUnder10MB();

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // USER PROFILE IMAGES
    // users/{userId}/...
    // ------------------------------------------------------------
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() &&
        (
          request.auth.uid == userId ||
          isAdmin()
        ) &&
        isImageUnder10MB();

      allow delete:
        if isSignedIn() &&
        (
          request.auth.uid == userId ||
          isAdmin()
        );
    }

    // ------------------------------------------------------------
    // ALTERNATIVE PROFILE IMAGE PATH
    // profile_images/{userId}/...
    // ------------------------------------------------------------
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() &&
        (
          request.auth.uid == userId ||
          isAdmin()
        ) &&
        isImageUnder10MB();

      allow delete:
        if isSignedIn() &&
        (
          request.auth.uid == userId ||
          isAdmin()
        );
    }

    // ------------------------------------------------------------
    // CURRENT PROFILE IMAGE PATH
    // profile/{userId}.jpg
    // ------------------------------------------------------------
    match /profile/{fileName} {
      allow read: if isSignedIn();

      allow create, update:
        if isSignedIn() &&
        (
          fileName == request.auth.uid + '.jpg' ||
          fileName == request.auth.uid + '.jpeg' ||
          fileName == request.auth.uid + '.png' ||
          fileName == request.auth.uid + '.webp' ||
          isAdmin()
        ) &&
        isImageUnder10MB();

      allow delete:
        if isSignedIn() &&
        (
          fileName == request.auth.uid + '.jpg' ||
          fileName == request.auth.uid + '.jpeg' ||
          fileName == request.auth.uid + '.png' ||
          fileName == request.auth.uid + '.webp' ||
          isAdmin()
        );
    }
// ------------------------------------------------------------
// SESSION PHOTO UPLOADS
// event_photos/{eventId}/{sessionId}/{photo}
// ------------------------------------------------------------
match /event_photos/{eventId}/{sessionId}/{fileName} {

  allow read: if isSignedIn();

  allow create: if
      isSignedIn() &&
      isImageUnder10MB();

  allow update: if false;

  allow delete: if
      isAdmin();
}
    // ------------------------------------------------------------
    // CERTIFICATE TEMPLATE FILES
    // ------------------------------------------------------------
    match /certificate_templates/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // GENERATED CERTIFICATES
    // ------------------------------------------------------------
    match /certificates/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // EVERYTHING ELSE
    // ------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}